# ==============================================================================
# Daak v2 — Environment Variable Template (Phase 2 Finalized)
# Never commit real values. Copy to service-local .env files (gitignored).
# ==============================================================================

# Supabase (Shared)
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# FastAPI Backend (apps/api)
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8081
DEMO_MODE=true
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
AI_FALLBACK_ENABLED=true

# Desktop Web Portal — Next.js (apps/web)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Citizen Mobile App — Expo (apps/mobile)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
